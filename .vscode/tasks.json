{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dev",
			"detail": "Vite dev server on http://localhost:5173",
			"type": "shell",
			"command": "pnpm dev",
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": { "regexp": "^x^" },
				"background": {
					"activeBegins": true,
					"beginsPattern": "VITE v",
					"endsPattern": "ready in"
				}
			}
		},
		{
			"label": "build",
			"type": "shell",
			"command": "pnpm build",
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "preview (wrangler)",
			"detail": "Built worker in workerd on http://localhost:4173, inspector on :9229",
			"type": "shell",
			"command": "pnpm preview",
			"dependsOn": "build",
			"isBackground": true,
			"problemMatcher": {
				"owner": "wrangler",
				"pattern": { "regexp": "^x^" },
				"background": {
					"activeBegins": true,
					"beginsPattern": "wrangler",
					"endsPattern": "Ready on http"
				}
			}
		},
		{
			"label": "check",
			"detail": "svelte-check + TypeScript",
			"type": "shell",
			"command": "pnpm check --output machine",
			"problemMatcher": {
				"owner": "svelte-check",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": {
					"regexp": "^\\d+\\s+(ERROR|WARNING)\\s+\"(.+)\"\\s+(\\d+):(\\d+)\\s+\"(.*)\"$",
					"severity": 1,
					"file": 2,
					"line": 3,
					"column": 4,
					"message": 5
				}
			}
		},
		{
			"label": "lint",
			"type": "shell",
			"command": "pnpm lint",
			"problemMatcher": ["$eslint-stylish"]
		},
		{
			"label": "format",
			"type": "shell",
			"command": "pnpm format",
			"problemMatcher": []
		},
		{
			"label": "test:unit",
			"type": "shell",
			"command": "pnpm test:unit --run",
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "test:e2e",
			"type": "shell",
			"command": "pnpm test:e2e",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "wrangler types",
			"detail": "Regenerate worker-configuration.d.ts after editing wrangler.jsonc",
			"type": "shell",
			"command": "pnpm gen",
			"problemMatcher": []
		},
		{
			"label": "install playwright browsers",
			"type": "shell",
			"command": "pnpm exec playwright install chromium",
			"problemMatcher": []
		}
	]
}
