{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Dev server (server-side)",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev",
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Chrome → localhost:5173",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}"
		},
		{
			"name": "Vitest: current file (server tests)",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm exec vitest run --project server ${relativeFile}",
			"cwd": "${workspaceFolder}"
		},
		{
			// Debugs the built worker running in workerd (same runtime as production).
			"name": "Attach: wrangler preview",
			"type": "node",
			"request": "attach",
			"port": 9229,
			"cwd": "/",
			"resolveSourceMapLocations": null,
			"attachExistingChildren": false,
			"autoAttachChildProcesses": false,
			"sourceMaps": true,
			"preLaunchTask": "preview (wrangler)"
		}
	],
	"compounds": [
		{
			"name": "Full stack (dev server + Chrome)",
			"configurations": ["Dev server (server-side)", "Chrome → localhost:5173"],
			"stopAll": true
		}
	]
}
