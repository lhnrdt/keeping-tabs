{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Top level is production: `wrangler deploy` → app.keeping-tabs.workers.dev
	"name": "app",
	"compatibility_date": "2026-10-21",
	"compatibility_flags": ["nodejs_als"],
	// The SvelteKit worker plus a daily cleanup job (worker/app.ts)
	"main": "worker/app.ts",
	// Daily at 03:17 UTC: remove groups deleted more than 30 days ago
	"triggers": { "crons": ["17 3 * * *"] },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "keeping-tabs-db",
			"database_id": "6438fd98-1eca-41a2-9340-09da5463b93f",
			"migrations_dir": "drizzle"
		}
	],
	"env": {
		// `wrangler deploy --env staging` → app-staging.keeping-tabs.workers.dev
		"staging": {
			"name": "app-staging",
			// Password-protected wrapper around the SvelteKit worker (see worker/staging.ts)
			"main": "worker/staging.ts",
			// Triggers aren't inherited by environments
			"triggers": { "crons": ["17 3 * * *"] },
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare",
				"run_worker_first": true
			},
			// Bindings aren't inherited by environments, so D1 is repeated here
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "keeping-tabs-db-staging",
					"database_id": "b8397c08-c301-442f-a626-b6bf0fe14f73",
					"migrations_dir": "drizzle"
				}
			]
		}
	}
}
