{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Top level is production: `wrangler deploy` → app.keeping-tabs.workers.dev
	"name": "app",
	"compatibility_date": "2026-10-21",
	"compatibility_flags": ["nodejs_als"],
	// The SvelteKit worker plus a daily cleanup job (worker/app.ts)
	"main": "worker/app.ts",
	// Daily at 03:17 UTC: remove groups deleted more than 30 days ago
	"triggers": { "crons": ["17 3 * * *"] },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Workers Logs (#81, free: 200,000 events a day): requests, exceptions and the app's
	// error lines from src/lib/server/error-log.ts, searchable per release in the dashboard
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	// Rate limits per address and Cloudflare location (#66, src/lib/server/rate-limit.ts);
	// namespace ids are per account, so staging has its own
	"ratelimits": [
		{
			"name": "RATE_LIMIT_SECRET",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "RATE_LIMIT_NEW_GROUP",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		},
		{ "name": "RATE_LIMIT_WRITE", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "keeping-tabs-db",
			"database_id": "6438fd98-1eca-41a2-9340-09da5463b93f",
			"migrations_dir": "drizzle"
		}
	],
	"env": {
		// `wrangler deploy --env staging` → app-staging.keeping-tabs.workers.dev
		"staging": {
			"name": "app-staging",
			// Password-protected wrapper around the SvelteKit worker (see worker/staging.ts)
			"main": "worker/staging.ts",
			// Triggers aren't inherited by environments
			"triggers": { "crons": ["17 3 * * *"] },
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare",
				"run_worker_first": true
			},
			"observability": { "enabled": true, "head_sampling_rate": 1 },
			// Separate counters from production
			"ratelimits": [
				{
					"name": "RATE_LIMIT_SECRET",
					"namespace_id": "2001",
					"simple": { "limit": 10, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_NEW_GROUP",
					"namespace_id": "2002",
					"simple": { "limit": 10, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_WRITE",
					"namespace_id": "2003",
					"simple": { "limit": 120, "period": 60 }
				}
			],
			// Bindings aren't inherited by environments, so D1 is repeated here
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "keeping-tabs-db-staging",
					"database_id": "b8397c08-c301-442f-a626-b6bf0fe14f73",
					"migrations_dir": "drizzle"
				}
			]
		}
	}
}
